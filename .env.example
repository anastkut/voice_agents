BACKEND_URL=http://localhost:8000

# LiveKit local dev server: `livekit-server --dev`
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Preset A — hosted (OpenAI, one key for LLM + STT + TTS)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4.1
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=sk-...
STT_MODEL=gpt-4o-transcribe
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-...
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Preset B — fully local, open weights (ollama + speaches), no API credits
# LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
# STT_BASE_URL=http://localhost:8001/v1    STT_API_KEY=local   STT_MODEL=Systran/faster-whisper-small.en
# TTS_BASE_URL=http://localhost:8001/v1    TTS_API_KEY=local   TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX  TTS_VOICE=af_heart
